<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Department Management");Map<String,Object> edit=(Map<String,Object>)request.getAttribute("editDepartment");List<Map<String,Object>> departments=(List<Map<String,Object>>)request.getAttribute("departments");%><%@ include file="WEB-INF/header.jsp" %>
<div class="page-intro cardx pad mb-4"><div class="intro-icon"><i class="fa-solid fa-hospital"></i></div><div><div class="eyebrow">ADMIN CONSOLE</div><h3 class="mb-1">Manage hospital departments</h3><p class="mini mb-0">Maintain work areas used by staff profiles, duty scheduling and supervisor access. Existing department IDs are preserved when you edit a department.</p></div></div>
<%if("1".equals(request.getParameter("success"))){%><div class="alert alert-success">Department changes saved successfully.</div><%}%>
<div class="department-layout"><section class="cardx pad"><div class="toolbar"><div><b><%=edit==null?"Add a department":"Edit department"%></b><div class="mini">Name is required. Description is optional.</div></div><span class="badge-soft b-blue">ADMIN ONLY</span></div><form method="post" action="departments" class="department-form"><input type="hidden" name="action" value="save"><input type="hidden" name="department_id" value="<%=edit==null?"":edit.get("id")%>"><label class="form-label" for="department_name">Department name</label><input id="department_name" name="department_name" class="form-control mb-3" maxlength="100" placeholder="e.g. Intensive Care Unit" value="<%=edit==null?"":edit.get("name")%>" required><label class="form-label" for="description">Description</label><textarea id="description" name="description" class="form-control mb-3" maxlength="255" rows="4" placeholder="Purpose or coverage of this department"><%=edit==null||edit.get("description")==null?"":edit.get("description")%></textarea><button class="btn-main" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i><%=edit==null?"Create department":"Save changes"%></button><%if(edit!=null){%> <a class="btn-soft" href="departments">Cancel</a><%}%></form><div class="info-strip mt-4"><i class="fa-solid fa-shield-halved"></i><span>Departments connected to staff, duties or supervisors cannot be deleted. Edit their name or description to preserve records.</span></div></section>
<section class="cardx pad"><div class="toolbar"><div><b>Department directory</b><div class="mini">A live view of the work areas currently configured in AssignPro.</div></div><span class="count-pill"><%=departments==null?0:departments.size()%> total</span></div><div id="department-react-tools" class="mb-3"></div><div class="table-responsive"><table class="table align-middle" id="department-table"><thead><tr><th>Department</th><th>Staff</th><th>Duties</th><th>Supervisors</th><th>Actions</th></tr></thead><tbody><%if(departments==null||departments.isEmpty()){%><tr><td colspan="5" class="mini">No departments have been created.</td></tr><%}else for(Map<String,Object>d:departments){%><tr data-search="<%=String.valueOf(d.get("name")).toLowerCase(Locale.ROOT)%> <%=d.get("description")==null?"":String.valueOf(d.get("description")).toLowerCase(Locale.ROOT)%>"><td><div class="department-name"><span class="department-symbol"><i class="fa-solid fa-building"></i></span><span><b><%=d.get("name")%></b><small><%=d.get("description")==null||String.valueOf(d.get("description")).isBlank()?"No description added":d.get("description")%></small></span></div></td><td><span class="metric-pill"><%=d.get("staff")%></span></td><td><span class="metric-pill"><%=d.get("duties")%></span></td><td><span class="metric-pill"><%=d.get("supervisors")%></span></td><td><div class="d-flex gap-2"><a class="btn-soft btn-sm" href="departments?edit=<%=d.get("id")%>" aria-label="Edit <%=d.get("name")%>"><i class="fa-solid fa-pen"></i></a><form method="post" action="departments" onsubmit="return confirmAction('Delete this department only if it is unused?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="department_id" value="<%=d.get("id")%>"><button class="btn-soft btn-sm text-danger" type="submit" aria-label="Delete <%=d.get("name")%>"><i class="fa-solid fa-trash"></i></button></form></div></td></tr><%}%></tbody></table></div><div id="department-empty" class="empty mt-2" hidden>No departments match your search.</div></section></div>
<script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script><script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script><script>
/* Small React enhancement: live search and visible-result count. JSP/Servlet remains the application core. */
(function(){const root=document.getElementById('department-react-tools');if(!root||!window.React||!window.ReactDOM)return;const e=React.createElement;function Tools(){const [query,setQuery]=React.useState('');React.useEffect(()=>{const q=query.trim().toLowerCase();let visible=0;document.querySelectorAll('#department-table tbody tr[data-search]').forEach(row=>{const show=row.dataset.search.includes(q);row.style.display=show?"":"none";if(show)visible++;});const empty=document.getElementById('department-empty');if(empty)empty.hidden=visible!==0;const count=document.getElementById('department-visible-count');if(count)count.textContent=visible+' shown';},[query]);return e('div',{className:'react-search-row'},e('label',{className:'search-box'},e('i',{className:'fa-solid fa-magnifying-glass'}),e('input',{type:'search',value:query,onChange:x=>setQuery(x.target.value),placeholder:'Search departments…','aria-label':'Search departments'})),e('span',{id:'department-visible-count',className:'mini'},(document.querySelectorAll('#department-table tbody tr[data-search]').length)+' shown'));}ReactDOM.createRoot(root).render(e(Tools));})();
</script>
<%@ include file="WEB-INF/footer.jsp" %>
