<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","My Duties");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Assigned duties</b><div class="mini">Acknowledge the duty, start it when work begins, mark it completed, then submit proof for supervisor/admin verification. You can request a duty change before starting.</div></div><a class="btn-soft" href="documents">Work proof</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Duty</th><th>Date</th><th>Window</th><th>Priority</th><th>Duty status</th><th>Change request</th><th>Proof</th><th>Action</th></tr></thead><tbody><%List<Map<String,Object>>rows=(List<Map<String,Object>>)request.getAttribute("rows");if(rows==null||rows.isEmpty()){%><tr><td colspan="8" class="mini">No duties assigned to you.</td></tr><%}else for(Map<String,Object>x:rows){String st=String.valueOf(x.get("c8"));String proof=String.valueOf(x.get("c9"));String cr=String.valueOf(x.get("c10"));%><tr><td><b><%=x.get("c3")%></b><div class="mini">#<%=x.get("c2")%></div></td><td><%=x.get("c4")%></td><td><%=x.get("c5")%> – <%=x.get("c6")%></td><td><span class="badge-soft <%=x.get("c7").equals("EMERGENCY")?"b-red":x.get("c7").equals("HIGH")?"b-amber":"b-gray"%>"><%=x.get("c7")%></span></td><td><span class="badge-soft b-blue"><%=st%></span></td><td><%if(cr.equals("PENDING")){%><span class="badge-soft b-amber">PENDING</span><div class="mini mt-1"><%=x.get("c11")%></div><%}else if(cr.equals("APPROVED")){%><span class="badge-soft b-green">APPROVED</span><%}else if(cr.equals("REJECTED")){%><span class="badge-soft b-red">REJECTED</span><%}else{%><span class="badge-soft b-gray">NONE</span><%}%></td><td><span class="badge-soft <%=proof.equals("VERIFIED")?"b-green":proof.equals("REJECTED")?"b-red":proof.equals("PENDING")?"b-amber":"b-gray"%>"><%=proof%></span></td><td><div class="d-flex flex-column gap-2"><%if(st.equals("ASSIGNED")){%><form method="post" action="my-duties"><input type="hidden" name="assignment_id" value="<%=x.get("c1")%>"><button class="btn-main" name="action" value="acknowledge">Acknowledge</button></form><%}else if(st.equals("ACKNOWLEDGED")){%><form method="post" action="my-duties"><input type="hidden" name="assignment_id" value="<%=x.get("c1")%>"><button class="btn-main" name="action" value="start">Start work</button></form><%}else if(st.equals("IN_PROGRESS")){%><form method="post" action="my-duties"><input type="hidden" name="assignment_id" value="<%=x.get("c1")%>"><button class="btn-main" name="action" value="complete" onclick="return confirmAction('Mark this duty as completed? You will then need to submit work proof for verification.')"><i class="fa-solid fa-check-circle"></i> Mark completed</button></form><%}else if(st.equals("COMPLETION_PENDING")){%><a class="btn-main" href="documents"><i class="fa-solid fa-upload"></i> Submit proof</a><div class="mini">Awaiting proof verification</div><%}else if(st.equals("COMPLETED")){%><span class="mini">Completed</span><%}else if(st.equals("CHANGE_REQUESTED")){%><span class="mini">Awaiting supervisor response</span><%}else if(st.equals("CANCELLED")){%><span class="mini">Assignment cancelled</span><%}%><%if((st.equals("ASSIGNED")||st.equals("ACKNOWLEDGED"))&&!cr.equals("PENDING")){%><button type="button" class="btn-soft" onclick="requestChange(<%=x.get("c1")%>)"><i class="fa-solid fa-arrows-rotate"></i> Request change</button><%}%></div></td></tr><%}%></tbody></table></div></div><script>function requestChange(id){var r=prompt('Why do you need this duty changed?');if(r===null)return;r=r.trim();if(r.length<5){alert('Please provide at least 5 characters.');return;}var f=document.createElement('form');f.method='post';f.action='my-duties';[['assignment_id',id],['action','change'],['reason',r]].forEach(function(v){var i=document.createElement('input');i.type='hidden';i.name=v[0];i.value=v[1];f.appendChild(i);});document.body.appendChild(f);f.submit();}</script><%@ include file="WEB-INF/footer.jsp" %>