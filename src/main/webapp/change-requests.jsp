<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%request.setAttribute("pageTitle","Duty Change Requests");%><%@ include file="WEB-INF/header.jsp" %>
<div class="cardx pad"><div class="toolbar"><div><b>Staff change requests</b><div class="mini">Review requests raised by staff for duties in your assigned department(s).</div></div><span class="badge-soft b-blue">Manager response</span></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Staff</th><th>Duty</th><th>Window</th><th>Reason</th><th>Status</th><th>Response</th></tr></thead><tbody>
<% List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("rows"); if(rows==null||rows.isEmpty()){%><tr><td colspan="6" class="mini">No change requests found.</td></tr><%}else for(Map<String,Object>x:rows){String st=String.valueOf(x.get("c12"));%>
<tr><td><b><%=x.get("c3")%></b><div class="mini"><%=x.get("c4")%></div></td><td><b><%=x.get("c5")%></b><div class="mini"><%=x.get("c9")%></div></td><td><%=x.get("c6")%><div class="mini"><%=x.get("c7")%> – <%=x.get("c8")%></div></td><td style="max-width:320px"><%=x.get("c10")%></td><td><span class="badge-soft <%=st.equals("PENDING")?"b-amber":st.equals("APPROVED")?"b-green":"b-red"%>"><%=st%></span><div class="mini"><%=x.get("c14")%></div></td><td><%if(st.equals("PENDING")){%><div class="d-flex flex-column gap-2"><form method="post" action="change-requests"><input type="hidden" name="request_id" value="<%=x.get("c1")%>"><input type="hidden" name="action" value="approve"><input class="form-control form-control-sm" name="response_note" placeholder="Optional response note"><button class="btn-soft" onclick="return confirmAction('Approve this change request?')"><i class="fa-solid fa-check"></i> Approve change</button></form><form method="post" action="change-requests"><input type="hidden" name="request_id" value="<%=x.get("c1")%>"><input type="hidden" name="action" value="reject"><input class="form-control form-control-sm" name="response_note" placeholder="Reason for rejection"><button class="btn-soft" onclick="return confirmAction('Reject this change request?')"><i class="fa-solid fa-xmark"></i> Reject</button></form></div><%}else{%><div class="mini"><%=x.get("c13")==null?"":x.get("c13")%></div><%}%></td></tr>
<%}%></tbody></table></div></div><%@ include file="WEB-INF/footer.jsp" %>
